# ==========================================================
# Konfigurasi server OMI Pet Hotel
# Salin file ini menjadi ".env" lalu sesuaikan bila perlu.
# ==========================================================

# --- Koneksi MySQL ---
# XAMPP default: host localhost, user root, password kosong.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=omidb_html

# --- Keamanan sesi (JWT) ---
# Ganti dengan teks acak panjang milik Anda sendiri.
JWT_SECRET=ubah-ini-menjadi-kunci-rahasia-acak-yang-panjang
JWT_EXPIRES_IN=8h

# --- Port server aplikasi ---
PORT=3000
